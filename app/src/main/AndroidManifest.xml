<?xml version='1.0' encoding='utf-8'?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.skarti.premium.v2">

    <uses-permission android:name="android.permission.INTERNET"/>

        <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

        <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>

        <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>

        <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>

        <!-- FIXED: Added foreground service permissions for Android 9+ -->
        <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
        
        <!-- FIXED: Battery optimization bypass permission -->
        <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
        
        <!-- FIXED: Post notifications permission for Android 13+ (API 33+) -->
        <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

        <uses-permission android:name="android.permission.VIBRATE"/>
        
        <!-- FIXED: Wake lock to prevent service from sleeping -->
        <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
        android:name="com.skartivpn.app.SKTHttpApp"
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:resizeableActivity="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name="com.skartivpn.app.LauncherActivity"
            android:exported="true"
            android:theme="@style/SplashScreenTheme"
            android:label="@string/loadiing">

            <intent-filter>

                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>

            </intent-filter>

        </activity>
 
        <activity android:exported="true"
            android:name="com.skartivpn.app.Error"/>
            
            

        <activity
            android:name="com.skartivpn.app.PhreakersMainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"/>
            
<service android:name="com.skartivpn.app.ui.ProxyService" />
		<activity
            android:name="com.skartivpn.app.ui.ProxySettings"
            android:label="@string/app_name" />

        <activity android:exported="true"
            android:name="com.skartivpn.app.activities.ConfigGeralActivity"
            android:parentActivityName="com.skartivpn.app.PhreakersMainActivity"
            android:label="@string/settings"/>

        <activity android:exported="true"
            android:name="com.skartivpn.app.activities.HostChecker"
            android:label="Host Checker"
            android:parentActivityName="com.skartivpn.app.PhreakersMainActivity"/>

       
        <activity
            android:name="com.skartivpn.inject.LaunchVpn"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:taskAffinity=".LaunchVPN"
            android:exported="true"
            android:theme="@style/AppThemeLogin"
            android:label="@string/app_name">

            <intent-filter>

                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.HOME"/>

            </intent-filter>

        </activity>

        <activity
            android:name="com.skartivpn.inject.util.DummyActivity"
            android:allowTaskReparenting="true"
            android:alwaysRetainTaskState="false"
            android:clearTaskOnLaunch="true"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:exported="true"
            android:noHistory="true"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.Translucent"/>

        <receiver android:exported="true"
             android:name="com.skartivpn.inject.MainReceiver">

            <intent-filter>

                <action android:name="com.skartivpn.inject.MainReceiver.ACTION_SERVICE_STOP">

                </action>

                <action android:name="com.skartivpn.inject.MainReceiver.ACTION_SERVICE_RESTART">

                </action>

            </intent-filter>

        </receiver>

        <!-- FIXED: VPN Service with proper foreground service configuration -->
        <service
            android:label="@string/app_name"
            android:name="com.skartivpn.inject.tunnel.vpn.TunnelVpnService"
            android:exported="true"
            android:enabled="true"
            android:stopWithTask="false"
            android:permission="android.permission.BIND_VPN_SERVICE">

            <intent-filter>

                <action android:name="android.net.VpnService"/>

            </intent-filter>

        </service>

        <!-- FIXED: SSH/Socks Service with proper foreground service configuration -->
        <service
            android:label="@string/app_name"
            android:name="com.skartivpn.inject.SocksHttpService"
            android:stopWithTask="false"
            android:exported="false">

        </service>

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false"/>
            
		<activity android:name="com.skartivpn.app.SktSpeedTest"/>
		<activity android:name="com.skartivpn.app.SktPremium"/>
		<activity android:name="com.skartivpn.app.Profile"/>
		
		<!-- Modern Server Selection Activity -->
		<activity
		    android:name="com.skartivpn.app.activities.ServerSelectionActivity"
		    android:exported="false"
		    android:label="Select Server"
		    android:parentActivityName="com.skartivpn.app.PhreakersMainActivity"
		    android:theme="@style/AppTheme"
		    android:screenOrientation="portrait"/>
		
		<!-- Modern Payload Selection Activity -->
		<activity
		    android:name="com.skartivpn.app.activities.PayloadSelectionActivity"
		    android:exported="false"
		    android:label="Select Payload"
		    android:parentActivityName="com.skartivpn.app.PhreakersMainActivity"
		    android:theme="@style/AppTheme"
		    android:screenOrientation="portrait"/>

		<!-- Config Import Activity - Handles file imports via intent filter -->
		<activity
		    android:name="com.skartivpn.app.activities.ConfigImportActivity"
		    android:exported="true"
		    android:label="Import VPN Config"
		    android:theme="@android:style/Theme.Translucent.NoTitleBar"
		    android:noHistory="true"
		    android:excludeFromRecents="true">

		    <!-- Intent filter for .ovpn files (OpenVPN config) -->
		    <intent-filter android:priority="100">
		        <action android:name="android.intent.action.VIEW" />
		        <action android:name="android.intent.action.EDIT" />
		        <action android:name="android.intent.action.PICK" />

		        <category android:name="android.intent.category.DEFAULT" />
		        <category android:name="android.intent.category.BROWSABLE" />

		        <!-- Support .ovpn files -->
		        <data android:scheme="file" />
		        <data android:scheme="content" />
		        <data android:mimeType="*/*" />
		        <data android:pathPattern=".*\\.ovpn" />
		        <data android:host="*" />
		    </intent-filter>

		    <!-- Intent filter for .conf files (alternative config) -->
		    <intent-filter android:priority="100">
		        <action android:name="android.intent.action.VIEW" />

		        <category android:name="android.intent.category.DEFAULT" />
		        <category android:name="android.intent.category.BROWSABLE" />

		        <data android:scheme="file" />
		        <data android:scheme="content" />
		        <data android:mimeType="*/*" />
		        <data android:pathPattern=".*\\.conf" />
		        <data android:host="*" />
		    </intent-filter>

		    <!-- Intent filter for text/plain mime type -->
		    <intent-filter android:priority="50">
		        <action android:name="android.intent.action.VIEW" />
		        <action android:name="android.intent.action.SEND" />

		        <category android:name="android.intent.category.DEFAULT" />
		        <category android:name="android.intent.category.BROWSABLE" />

		        <data android:mimeType="text/plain" />
		        <data android:mimeType="application/x-openvpn-profile" />
		    </intent-filter>

		    <!-- Intent filter for custom scheme (deep linking) -->
		    <intent-filter android:priority="100">
		        <action android:name="android.intent.action.VIEW" />

		        <category android:name="android.intent.category.DEFAULT" />
		        <category android:name="android.intent.category.BROWSABLE" />

		        <data android:scheme="skartivpn" />
		        <data android:host="import" />
		    </intent-filter>

		</activity>

    </application>

</manifest>
